<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access only. No storage/camera/mic/location permission: ROM import goes
         through the Storage Access Framework (no broad storage grant needed), and the
         app has no use for any of the others. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Declared but not required: the app is fully usable with on-screen touch
         controls, so it must still install on phones with no gamepad hardware. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.EmuRM"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize|density|navigation"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.EmuRM.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- "Share ROM to EmuRM" from a file manager or another app. Handled
                 natively (ContentResolver, no network round-trip) and handed to the
                 same import pipeline the in-page file picker uses. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- "Open with EmuRM" on a ROM file tapped directly in a file manager (e.g.
                 Samsung My Files) — the Game Discovery feature's intended end state. Scoped
                 to "*/*" rather than per-extension on purpose: ROM extensions (.nes, .sfc,
                 .gba…) have no registered MIME type, so a file manager almost always reports
                 them as application/octet-stream or leaves the type unset rather than
                 something matchable by extension in a manifest — the same reality every
                 Android emulator frontend deals with. The cost is that EmuRM becomes a
                 candidate "Open with" app for any file, not just ROMs; MainActivity's own
                 import pipeline is what actually rejects anything it can't recognize, the
                 same rejection path a misdropped file already goes through today. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="*/*" />
            </intent-filter>
        </activity>

    </application>
</manifest>
