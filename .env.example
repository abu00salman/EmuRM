# Optional. Where libretro WASM cores are served from.
# Leave empty to use the prebuilt cores on jsDelivr for every system that has one.
# Set to "/cores" (or a CDN URL) after placing <core>_libretro.js + .wasm files there.
# Systems whose core has no public web build (MSX, Nintendo 64) need this.
NEXT_PUBLIC_CORE_BASE=
